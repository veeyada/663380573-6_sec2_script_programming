{
    "tasks": [
        {
            "name": "Load Sales Data CSV",
            "type": "load_csv",
            "file_path": "data/input_sales.csv",
            "output_data_key": "raw_sales_data"
        },
        {
            "name": "Aggregate Sales by Customer",
            "type": "transform_csv_aggregate",
            "input_data_key": "raw_sales_data",
            "output_data_key": "customer_sales_summary",
            "group_by_field": "Customer",
            "aggregate_field": "Amount",
            "aggregate_type": "sum"
        },
        {
            "name": "Save Aggregated Sales CSV",
            "type": "save_csv",
            "file_path": "data/processed_sales_by_customer.csv",
            "input_data_key": "customer_sales_summary",
            "fieldnames": [
                "Customer",
                "Total_Amount"
            ]
        },
        {
            "name": "Convert Raw Sales to JSON",
            "type": "csv_to_json_conversion",
            "input_data_key": "raw_sales_data",
            "output_data_key": "raw_sales_json"
        },
        {
            "name": "Save Raw Sales JSON",
            "type": "save_json",
            "file_path": "data/sales_data.json",
            "input_data_key": "raw_sales_json",
            "indent": 4
        },
        {
            "name": "Load Inventory Data JSON",
            "type": "load_json",
            "file_path": "data/input_inventory.json",
            "output_data_key": "raw_inventory_data"
        },
        {
            "name": "Update Inventory Stock & Add Product",
            "type": "update_json_data",
            "input_data_key": "raw_inventory_data",
            "output_data_key": "updated_inventory_data",
            "updates": [
                {
                    "path": "0.stock",
                    "value": 75,
                    "operation": "set"
                },
                {
                    "path": "1.details.layout",
                    "value": "UK ISO",
                    "operation": "set"
                },
                {
                    "path": "2.details.dpi",
                    "value": 2000,
                    "operation": "set"
                },
                {
                    "path": "",
                    "value": {
                        "id": "PROD004",
                        "name": "Smart Speaker",
                        "category": "Audio",
                        "stock": 40,
                        "details": {
                            "brand": "SoundGenius",
                            "features": [
                                "Voice Assistant",
                                "Multi-room"
                            ]
                        }
                    },
                    "operation": "add_to_list"
                },
                {
                    "path": "0.details.color",
                    "value": "Space Grey",
                    "operation": "set"
                }
            ]
        },
        {
            "name": "Query Specific Product Detail",
            "type": "query_json_data",
            "input_data_key": "updated_inventory_data",
            "output_data_key": "queried_product_brand",
            "path": "0.details.brand"
        },
        {
            "name": "Save Updated Inventory JSON",
            "type": "save_json",
            "file_path": "data/updated_inventory.json",
            "input_data_key": "updated_inventory_data",
            "indent": 2
        },
        {
            "name": "Filter High-Value Orders (Amount > 100)",
            "type": "filter_csv",
            "input_data_key": "raw_sales_data",
            "output_data_key": "high_value_orders",
            "filter_field": "Amount",
            "operator": ">",
            "value": 100
        },
        {
            "name": "Save High-Value Orders CSV",
            "type": "save_csv",
            "file_path": "data/high_value_orders.csv",
            "input_data_key": "high_value_orders"
        },
        {
            "name": "Average Order Amount by Customer",
            "type": "transform_csv_aggregate",
            "input_data_key": "raw_sales_data",
            "output_data_key": "customer_average_order",
            "group_by_field": "Customer",
            "aggregate_field": "Amount",
            "aggregate_type": "average"
        },
        {
            "name": "Save Average Order CSV",
            "type": "save_csv",
            "file_path": "data/average_order_by_customer.csv",
            "input_data_key": "customer_average_order"
        },
        {
            "name": "Flatten Inventory JSON to CSV",
            "type": "json_to_csv_conversion",
            "input_data_key": "updated_inventory_data",
            "output_data_key": "inventory_flat",
            "fieldnames": [
                "id",
                "name",
                "category",
                "stock",
                "details.brand",
                "details.model",
                "details.layout",
                "details.dpi",
                "details.color",
                "details.features"
            ]
        },
        {
            "name": "Save Flattened Inventory CSV",
            "type": "save_csv",
            "file_path": "data/inventory_flat.csv",
            "input_data_key": "inventory_flat"
        }
    ]
}