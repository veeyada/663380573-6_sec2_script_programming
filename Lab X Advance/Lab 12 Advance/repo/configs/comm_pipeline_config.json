{
    "error_notification": {
        "enabled": true,
        "to": ["${SENDER_EMAIL}"]
    },
    "tasks": [
        {
            "name": "Send Daily Sales Report Email",
            "type": "send_email",
            "parameters": {
                "recipients": {
                    "to": ["${TEST_RECIPIENT_EMAIL}"],
                    "cc": ["${SENDER_EMAIL}"]
                },
                "subject_template": "Daily Sales Report - {report_date}",
                "body_template": "Dear Team,\n\nPlease find the latest sales report for {report_date} attached. Total sales: ${sales_figure:,.2f}. Total active customers: {total_customers}. Top product: {top_product}.\n\nBest regards,\nAutomated Agent (run {run_id})",
                "html_body_template": "<html><body style=\"font-family:Arial,sans-serif;color:#222\"><h2 style=\"color:#1a73e8\">Daily Sales Report - {report_date}</h2><p>Dear Team,</p><p>Please find the latest <b>{report_name}</b> attached.</p><table cellpadding=\"8\" style=\"border-collapse:collapse;border:1px solid #ccc\"><tr style=\"background:#f1f3f4\"><th align=\"left\">Metric</th><th align=\"right\">Value</th></tr><tr><td>Total sales</td><td align=\"right\">${sales_figure:,.2f}</td></tr><tr><td>Active customers</td><td align=\"right\">{total_customers}</td></tr><tr><td>Top product</td><td align=\"right\">{top_product}</td></tr></table><p>Best regards,<br>Automated Agent <small style=\"color:#888\">(run {run_id})</small></p></body></html>",
                "attachments": [
                    "{attachment_path_1}",
                    "{attachment_path_2}"
                ],
                "is_html": false
            },
            "output_context_key": "daily_report_email"
        },
        {
            "name": "Send Sales Alert SMS",
            "type": "send_sms",
            "parameters": {
                "phone_numbers": ["${TEST_SMS_PHONE_NUMBER}"],
                "subject_template": "[SMS] Sales {report_date}",
                "message_template": "Sales for {report_date} are ${sales_figure:,.2f}. Total customers: {total_customers}. Report sent to {daily_report_email.recipients.to.0}. Review!",
                "carrier_name": "${TEST_SMS_CARRIER}"
            },
            "output_context_key": "sales_sms"
        },
        {
            "name": "Simulate Incoming Request Email (to self)",
            "type": "send_email",
            "parameters": {
                "recipients": {
                    "to": ["${SENDER_EMAIL}"]
                },
                "subject_template": "Data Request for {report_date} - Urgent [run {run_id}]",
                "body_template": "Hello Agent,\n\nWe need the latest data for {report_date}. Please process urgently. This email includes attachments.\n\nThank you,\nClient Team\n\n\nThis is an urgent request for new data processing.",
                "attachments": [
                    "data/reports/sales_report.pdf",
                    "data/reports/summary_data.xlsx"
                ],
                "is_html": false
            },
            "output_context_key": "simulated_email_sent"
        },
        {
            "name": "Process Incoming Data Requests",
            "type": "process_inbox",
            "parameters": {
                "mailbox": "INBOX",
                "search_criteria": {
                    "status": "UNSEEN",
                    "fallback_status": "ALL",
                    "from_sender": "${SENDER_EMAIL}",
                    "subject_contains": ["Data Request", "{run_id}"]
                },
                "wait_seconds": 5,
                "max_attempts": 6,
                "retry_interval_seconds": 10,
                "rules": [
                    {
                        "name": "save_request_attachments",
                        "if": {
                            "from_sender": "{sender_email}",
                            "subject_contains": "Request"
                        },
                        "then": {
                            "download_attachments_to": "data/incoming_attachments/{report_date}",
                            "allowed_extensions": [".pdf"],
                            "rename_template": "request_{uid}_{filename}",
                            "mark_as_read": true
                        }
                    },
                    {
                        "name": "urgent_sms_alert",
                        "if": {
                            "body_contains": "urgent",
                            "has_attachments": true
                        },
                        "then": {
                            "send_sms_alert": true,
                            "alert_phone_numbers": ["${TEST_SMS_PHONE_NUMBER}"],
                            "alert_carrier": "${TEST_SMS_CARRIER}",
                            "alert_message_template": "URGENT: New Data Request from {sender_address} - Subject: {subject}. Saved: {attachments_meta.0.filename}"
                        }
                    },
                    {
                        "name": "auto_reply",
                        "if": {
                            "body_contains": "new data processing"
                        },
                        "then": {
                            "reply_with_template": "Agent received your request for '{subject}'. We are now processing the new data ({report_name}, sales ${sales_figure:,.2f}). You will receive an update shortly.",
                            "reply_subject_template": "Re: {subject} - Received & Processing"
                        }
                    }
                ]
            },
            "output_context_key": "processed_inbox_results"
        }
    ]
}
